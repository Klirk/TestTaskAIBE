POSTGRES_USER=helpdesk_user
POSTGRES_PASSWORD=helpdesk_secret_password
POSTGRES_DB=helpdesk
DATABASE_URL=postgresql+asyncpg://helpdesk_user:helpdesk_secret_password@localhost:5432/helpdesk

RABBITMQ_DEFAULT_USER=helpdesk_mq
RABBITMQ_DEFAULT_PASS=helpdesk_mq_secret
CELERY_BROKER_URL=amqp://helpdesk_mq:helpdesk_mq_secret@localhost:5672//

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini
LLM_RPM_LIMIT=60
LLM_MIN_LATENCY_SECONDS=5.0
LLM_MAX_LATENCY_SECONDS=30.0

WORKER_CONCURRENCY=25
WORKER_POLL_INTERVAL_SECONDS=0.5

DELIVERY_MAX_RETRIES=5
DELIVERY_TIMEOUT_SECONDS=5.0

MOCK_HELPDESK_FAILURE_RATE=0.2
